{
  "name": "caps-engine",
  "module": "src/index.ts",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "latest",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "bestzip": "^2.2.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "testcontainers": "^11.13.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev:api": "bun run --bun --watch src/services/api/index.ts",
    "dev:worker": "bun run --bun --watch src/services/worker/worker.ts",
    "dev:scheduler": "bun run --bun --watch src/services/scheduler/index.ts",
    "build:api": "bun run scripts/compile.ts api",
    "build:worker": "bun run scripts/compile.ts worker",
    "build:scheduler": "bun run scripts/compile.ts scheduler",
    "build": "bun run build:api && bun run build:worker && bun run build:scheduler && bun run scripts/package-app.ts",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "test:coverage": "vitest run --coverage",
    "db:dev": "bunx --bun prisma dev",
    "db:seed": "bunx --bun prisma db seed",
    "db:studio": "bunx prisma studio",
    "db:generate": "bun prisma generate",
    "openapi-ts:generate": "openapi-typescript",
    "db:migrate": "bun prisma migrate dev",
    "db:reset": "bun prisma migrate reset --force"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@dhis2/data-engine": "^3.17.0-beta.1",
    "@dhis2/multi-calendar-dates": "^2.1.2",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@hisptz/dhis2-utils": "^2.0.19",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "amqplib": "^0.10.9",
    "axios": "1.15.0",
    "baseline-browser-mapping": "^2.10.35",
    "caniuse-lite": "^1.0.30001797",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "elysia": "^1.4.30",
    "fflate": "^0.8.2",
    "figlet": "^1.11.0",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "prisma": "^7.7.0",
    "winston": "^3.19.0",
    "zarrita": "^0.7.2",
    "zod": "^4.3.6"
  }
}
