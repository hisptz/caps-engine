# =============================================================
# Postgres (Compose bootstrap + Prisma)
# =============================================================
POSTGRES_USER=caps
POSTGRES_PASSWORD=caps
POSTGRES_DB=caps
DATABASE_URL=postgresql://caps:caps@localhost/caps
# Used by `make test` (Makefile sets DATABASE_URL from this). Create DB caps_test first.
DATABASE_URL_TEST=postgresql://caps:caps@localhost/caps_test

# =============================================================
# RabbitMQ
# =============================================================
RABBITMQ_USER=caps
RABBITMQ_PASSWORD=caps
RABBITMQ_URL=amqp://caps:caps@localhost:5672

# =============================================================
# DHIS2 (demo pair — never use in production)
# =============================================================
DHIS2_BASE_URL=http://localhost:8080
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district

# =============================================================
# API
# =============================================================
# Process listen port (env.ts). Compose maps host API_PORT → container 4000.
PORT=4000
API_PORT=4000

# =============================================================
# Environment
# =============================================================
NODE_ENV=production
OUTPUTS_DIR=./outputs
# Empty disables the OTLP exporter (env.ts default).
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================
# CHAP
# =============================================================
CHAP_BASE_URL=http://localhost:8000
# Optional. Required when CHAP /system/info reports auth_required=true.
CHAP_API_TOKEN=

# =============================================================
# Climate / Open Climate Service
# =============================================================
# Host-mode defaults match env.ts. In Docker, set a hostname reachable from the
# container (not localhost unless the service is on the same Compose network).
CLIMATE_API_BASE_URL=http://localhost:8001
CLIMATE_DATA_BASE_URL=http://localhost:8081

# =============================================================
# Optional: share CHAP Postgres/RabbitMQ (`make up-chap`)
# =============================================================
# CHAP_NETWORK=chap_default
# CHAP_DATABASE_URL=postgresql://caps:caps@chap-postgres:5432/caps
# CHAP_RABBITMQ_URL=amqp://caps:caps@chap-rabbitmq:5672
